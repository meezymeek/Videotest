# ~/.hermes/.env — secrets and platform credentials only (behavior goes in config.yaml).
# Variable names verified against Hermes messaging docs 2026-11-03.

# Home Assistant plugin (hermes plugins install homeassistant)
HASS_TOKEN=
HASS_URL=http://127.0.0.1:8123
HASS_HOME_CHANNEL=notify.nomad_screen

# Matrix (self-hosted Conduit on the node)
MATRIX_HOMESERVER=http://127.0.0.1:6167
MATRIX_USER_ID=@nomad:nomad.lan
MATRIX_ACCESS_TOKEN=
MATRIX_ALLOWED_USERS=@hayden:nomad.lan
MATRIX_HOME_ROOM=
MATRIX_E2EE_MODE=optional

# API server (used by the Meshtastic/SMS/LXMF bridges and the lid dashboard)
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=

# Webhooks (HA automations -> Hermes)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644
WEBHOOK_SECRET=

# Email over radio (local MTA fed by Pat/Winlink)
EMAIL_ADDRESS=nomad@nomad.lan
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=127.0.0.1
EMAIL_IMAP_PORT=143
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=25
EMAIL_POLL_INTERVAL=60
EMAIL_ALLOWED_USERS=

# Telegram (only works with WAN up)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Dashboard auth (hermes dashboard --host 0.0.0.0)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hayden
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# WiCi One, once it's in the bay
WICI_API_KEY=
